# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# Neon PostgreSQL connection string (from the Neon dashboard).
# Use the pooled connection string for the app; the direct string for migrations
# if you ever see connection errors with `prisma migrate dev`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Canonical URL of the app (no trailing slash).
# Local dev: http://localhost:3000   Production: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Optional: creates/updates an admin account when running `npm run db:seed`.
# The admin is the only role allowed to create works via POST /api/works.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Stripe (TEST MODE ONLY) ---------------------------------------------
# Secret key: Stripe Dashboard → Developers → API keys → "Test mode".
# Starts with sk_test_ — never a live (sk_live_) key for this project.
STRIPE_SECRET_KEY=""

# Webhook signing secret. Local development: run the Stripe CLI
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and copy the whsec_… value it prints into here (restart `npm run dev`).
# Production: the signing secret of your configured endpoint.
STRIPE_WEBHOOK_SECRET=""

# Canonical site origin, no trailing slash — used for Stripe
# success/cancel return URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
