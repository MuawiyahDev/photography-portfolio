// Prisma schema — the shape of your PostgreSQL database.
// Run `npx prisma migrate dev` after changing this file.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the others cover common deployment
  // runtimes (Vercel serverless = rhel-openssl-3.0.x).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A registered account. `passwordHash` stores a bcrypt hash —
// never the plain-text password. `role` decides what the user
// may do: "ADMIN" can create works; "USER" cannot.
model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String
  role         String     @default("USER")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[]
  ratings      Rating[]
  orders       Order[]
}

// One portfolio photograph shown in the gallery grid.
// `slug` is the stable public id (e.g. "theo-daylight").
// `span` drives the mosaic layout: "wide" | "tall" | null.
model Work {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  category    String
  src         String
  alt         String
  width       Int
  height      Int
  span        String?
  description String?
  link        String?
  // Print price in MINOR units (cents) — never a float, so no
  // floating-point drift. NULL = not for sale (no buy button).
  priceCents  Int?
  currency    String     @default("USD")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  ratings     Rating[]
  orderItems  OrderItem[]
}

// Lifecycle of one purchase attempt. Only the verified Stripe webhook
// may move an order to PAID (see app/api/webhooks/stripe/route.js).
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// One checkout attempt by a signed-in user. Money columns are integers
// in the currency's minor unit (e.g. USD cents).
// `requestId` is a client-generated per-attempt id: the unique index
// makes duplicate/rapid double-click submissions reuse the same order
// instead of creating a second one.
model Order {
  id                      String      @id @default(cuid())
  userId                  String
  status                  OrderStatus @default(PENDING)
  currency                String      @default("USD")
  subtotalCents           Int
  totalCents              Int
  requestId               String?     @unique
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                   OrderItem[]

  @@index([userId, createdAt])
}

// A line on an order. Title and price are purchase-time SNAPSHOTs:
// editing or even deleting the photograph later never rewrites
// what the customer actually paid.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  workId         String
  workTitle      String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: an admin cannot delete a photograph that appears on a
  // paid order — order history must stay intact.
  work           Work     @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// Which works a user has favorited. The unique pair constraint means
// you can never save the same work twice — the database enforces it.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

// A user's star rating (1–5) of one work — account-based, exactly
// like Favorite: it survives a new device. value 0 is never stored;
// un-rating deletes the row.
model Rating {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

// An inquiry submitted through the contact form.
model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  projectType String
  message     String
  createdAt   DateTime @default(now())
}

// Editable site content managed by the admin dashboard.
// One row per section: key = "hero" | "about" | "contact".
// `data` is a JSON document shaped by that section's zod schema.
model SiteSetting {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gallery categories (the portfolio filter tabs), managed in the
// dashboard. Work.category stores the category's slug as a string —
// routes validate it exists on write, and a category can't be
// deleted while works still use it.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
